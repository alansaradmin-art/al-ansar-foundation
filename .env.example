# ── Frontend (safe to expose to the browser — Vite only bundles VITE_* vars) ──
VITE_CLERK_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set this ONLY in Vercel's production environment, and ONLY if Clerk Dashboard
# → Domains shows your *.vercel.app domain needs a proxy (Production instances
# on a shared domain like *.vercel.app can't get a clerk.<domain> DNS record).
# Leave unset for local dev and for any Clerk Development-instance key — those
# talk to Clerk's *.clerk.accounts.dev domain directly, no proxy needed.
# Value = the exact "Clerk proxy URL" Clerk Dashboard shows you, e.g.
# https://al-ansar-foundation.vercel.app/__clerk
VITE_CLERK_PROXY_URL=

# ── Server-only (Vercel serverless functions, api/*) ──────────────────────
# NEVER prefix these with VITE_ — that would ship them to the browser bundle.
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
# Optional override for api/__clerk/[...path].ts's proxy upstream. Only needed if
# the fallback (decoded from VITE_CLERK_PUBLISHABLE_KEY) turns out wrong — check
# https://<your-domain>/__clerk/__debug after deploying. Get the correct value from
# Clerk Dashboard → Domains → your proxy row → "Copy setup instructions".
CLERK_PROXY_UPSTREAM=
SUPABASE_SERVICE_ROLE_KEY=
# Foundation admin's sign-in email — the Clerk webhook grants this one
# address role=ADMIN on first sign-in; every other email is matched against
# the managers table and provisioned as role=MANAGER.
FOUNDATION_ADMIN_EMAIL=alansar.admin@gmail.com
